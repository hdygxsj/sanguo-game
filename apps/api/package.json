{
  "name": "@agent-arena/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:setup": "prisma generate && RUST_LOG=info prisma db push && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.1.0",
    "@fastify/websocket": "11.2.0",
    "@prisma/client": "6.16.2",
    "fastify": "5.6.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "prisma": "6.16.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
